# OpenReality monorepo
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log

# Never commit local venvs or caches from any project
**/venv/
**/.shared/
**/.cache/
**/.cuda_home/
**/.model_ready
**/outputs/*
!**/outputs/.gitkeep

# Large binary artifacts
*.safetensors
*.gguf
*.bin
*.ckpt
*.pt
*.pth
*.glb
*.mp4

# justsay local uploads / project shots (keep examples)
**/uploads/
justsay/shots.json
justsay/workflows/*.json
!justsay/workflows/.gitkeep
justsay
third_party
.taste-skill
.impeccable